<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    tools:context=".EdicaoNomesActivity">

    <ImageView
        android:id="@+id/ic_voltar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/cd_voltar"
        android:focusable="true"
        app:tint="@color/icon_tint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_voltar" />

    <TextView
        android:id="@+id/txtTituloEdicao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/titulo_editar_nomes"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/ic_voltar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ic_voltar"
        app:layout_constraintTop_toTopOf="@+id/ic_voltar" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutPlayer1"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:boxStrokeColor="@color/icon_tint"
        app:hintTextColor="@color/icon_tint"
        app:endIconTint="@color/icon_tint"
        app:counterEnabled="true"
        app:counterMaxLength="30"
        app:endIconMode="clear_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTituloEdicao">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtPlayer1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_player1"
            android:inputType="textCapWords"
            android:maxLength="30"
            android:maxLines="1"
            android:textColor="@color/icon_tint"
            android:textCursorDrawable="@null" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutPlayer2"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:boxStrokeColor="@color/icon_tint"
        app:hintTextColor="@color/icon_tint"
        app:endIconTint="@color/icon_tint"
        app:counterEnabled="true"
        app:counterMaxLength="30"
        app:endIconMode="clear_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPlayer1">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtPlayer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_player2"
            android:inputType="textCapWords"
            android:maxLength="30"
            android:maxLines="1"
            android:textColor="@color/icon_tint"
            android:textCursorDrawable="@null" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSalvar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/btn_salvar"
        android:textColor="@color/btn_historico_text"
        android:textSize="16sp"
        app:backgroundTint="@color/btn_historico_background"
        app:cornerRadius="4dp"
        app:layout_constraintEnd_toEndOf="@+id/layoutPlayer2"
        app:layout_constraintTop_toBottomOf="@id/layoutPlayer2" />

</androidx.constraintlayout.widget.ConstraintLayout>