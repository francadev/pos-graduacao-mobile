<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCentro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_history" />

    <TextView
        android:id="@+id/txtPlayer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:text="Player 1"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/ic_edit_player1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <TextView
        android:id="@+id/txtVitoriasPlayer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Vitórias: 0"
        app:layout_constraintStart_toStartOf="@+id/txtPlayer1"
        app:layout_constraintTop_toBottomOf="@+id/txtPlayer1" />

    <TextView
        android:id="@+id/txtPlayer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Player 2"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/ic_edit_player2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
        app:layout_constraintTop_toTopOf="@+id/txtPlayer1" />

    <TextView
        android:id="@+id/txtVitoriasPlayer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Vitórias: 0"
        app:layout_constraintStart_toStartOf="@+id/txtPlayer2"
        app:layout_constraintTop_toBottomOf="@+id/txtPlayer2" />

    <ImageView
        android:id="@+id/ic_edit_player1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/txtPlayer1"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
        app:layout_constraintStart_toEndOf="@+id/txtPlayer1"
        app:layout_constraintTop_toTopOf="@+id/txtPlayer1"
        app:srcCompat="@drawable/ic_edit" />

    <ImageView
        android:id="@+id/ic_edit_player2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/txtPlayer2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtPlayer2"
        app:layout_constraintTop_toTopOf="@+id/txtPlayer2"
        app:srcCompat="@drawable/ic_edit" />

    <TextView
        android:id="@+id/txtNumPontosPlayer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="0"
        android:textSize="96sp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtVitoriasPlayer1" />

    <TextView
        android:id="@+id/txtNumPontosPlayer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="0"
        android:textSize="96sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
        app:layout_constraintTop_toBottomOf="@+id/txtVitoriasPlayer2" />

    <TextView
        android:id="@+id/txtPontosPlayer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pontos"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtNumPontosPlayer1" />

    <TextView
        android:id="@+id/txtPontosPlayer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pontos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
        app:layout_constraintTop_toBottomOf="@+id/txtNumPontosPlayer2" />

    <Button
        android:id="@+id/btnMais1Player1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+1"
        android:textSize="14sp"
        app:cornerRadius="20dp"
        app:layout_constraintEnd_toStartOf="@id/btnMais3Player1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtPontosPlayer1" />

    <Button
        android:id="@+id/btnMais3Player1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+3"
        android:textSize="14sp"
        app:cornerRadius="20dp"
        app:layout_constraintEnd_toStartOf="@+id/btnMais6Player1"
        app:layout_constraintStart_toEndOf="@+id/btnMais1Player1"
        app:layout_constraintTop_toTopOf="@+id/btnMais1Player1" />

    <Button
        android:id="@+id/btnMais6Player1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+6"
        android:textSize="14sp"
        app:cornerRadius="20dp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
        app:layout_constraintStart_toEndOf="@id/btnMais3Player1"
        app:layout_constraintTop_toTopOf="@+id/btnMais1Player1" />

    <Button
        android:id="@+id/btnMais9Player1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+9"
        android:textSize="14sp"
        app:cornerRadius="20dp"
        app:layout_constraintEnd_toStartOf="@id/btnMais12Player1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMais1Player1" />

    <Button
        android:id="@+id/btnMais12Player1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+12"
        android:textSize="14sp"
        app:cornerRadius="20dp"
        app:layout_constraintEnd_toStartOf="@+id/btnMenos1Player1"
        app:layout_constraintStart_toEndOf="@+id/btnMais9Player1"
        app:layout_constraintTop_toTopOf="@+id/btnMais9Player1" />

    <Button
        android:id="@+id/btnMenos1Player1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="-1"
        android:textSize="14sp"
        app:cornerRadius="20dp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
        app:layout_constraintStart_toEndOf="@id/btnMais12Player1"
        app:layout_constraintTop_toTopOf="@+id/btnMais9Player1" />

</androidx.constraintlayout.widget.ConstraintLayout>