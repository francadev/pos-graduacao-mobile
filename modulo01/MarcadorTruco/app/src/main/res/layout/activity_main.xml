<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineCentro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.50" />

        <TextView
            android:id="@+id/txtPlayer1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="4dp"
            android:text="@string/player1_default"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/ic_edit_player1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtVitoriasPlayer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/vitorias_default"
            app:layout_constraintStart_toStartOf="@+id/txtPlayer1"
            app:layout_constraintTop_toBottomOf="@+id/txtPlayer1" />

        <TextView
            android:id="@+id/txtPlayer2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:text="@string/player2_default"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/ic_edit_player2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
            app:layout_constraintTop_toTopOf="@+id/txtPlayer1" />

        <TextView
            android:id="@+id/txtVitoriasPlayer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/vitorias_default"
            app:layout_constraintStart_toStartOf="@+id/txtPlayer2"
            app:layout_constraintTop_toBottomOf="@+id/txtPlayer2" />

        <ImageView
            android:id="@+id/ic_edit_player1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/cd_editar_nome"
            app:tint="@color/icon_tint"
            app:layout_constraintBottom_toBottomOf="@+id/txtPlayer1"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
            app:layout_constraintStart_toEndOf="@+id/txtPlayer1"
            app:layout_constraintTop_toTopOf="@+id/txtPlayer1"
            app:srcCompat="@drawable/ic_editar" />

        <ImageView
            android:id="@+id/ic_edit_player2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/cd_editar_nome"
            app:tint="@color/icon_tint"
            app:layout_constraintBottom_toBottomOf="@+id/txtPlayer2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtPlayer2"
            app:layout_constraintTop_toTopOf="@+id/txtPlayer2"
            app:srcCompat="@drawable/ic_editar" />

        <TextView
            android:id="@+id/txtNumPontosPlayer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="0"
            android:textSize="96sp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtVitoriasPlayer1" />

        <TextView
            android:id="@+id/txtNumPontosPlayer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="0"
            android:textSize="96sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
            app:layout_constraintTop_toBottomOf="@+id/txtVitoriasPlayer2" />

        <TextView
            android:id="@+id/txtPontosPlayer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_pontos"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtNumPontosPlayer1" />

        <TextView
            android:id="@+id/txtPontosPlayer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_pontos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
            app:layout_constraintTop_toBottomOf="@+id/txtNumPontosPlayer2" />

        <Button
            android:id="@+id/btnMais1Player1"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="36dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+1"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintEnd_toStartOf="@id/btnMais3Player1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtPontosPlayer1" />

        <Button
            android:id="@+id/btnMais1Player2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="36dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+1"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintEnd_toStartOf="@id/btnMais3Player2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
            app:layout_constraintTop_toBottomOf="@+id/txtPontosPlayer2" />

        <Button
            android:id="@+id/btnMais3Player1"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+3"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintEnd_toStartOf="@+id/btnMais6Player1"
            app:layout_constraintStart_toEndOf="@+id/btnMais1Player1"
            app:layout_constraintTop_toTopOf="@+id/btnMais1Player1" />

        <Button
            android:id="@+id/btnMais3Player2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+3"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintEnd_toStartOf="@id/btnMais6Player2"
            app:layout_constraintStart_toEndOf="@+id/btnMais1Player2"
            app:layout_constraintTop_toTopOf="@+id/btnMais1Player2" />

        <Button
            android:id="@+id/btnMais6Player1"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+6"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
            app:layout_constraintStart_toEndOf="@id/btnMais3Player1"
            app:layout_constraintTop_toTopOf="@+id/btnMais1Player1" />

        <Button
            android:id="@+id/btnMais6Player2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+6"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnMais3Player2"
            app:layout_constraintTop_toTopOf="@+id/btnMais3Player2" />

        <Button
            android:id="@+id/btnMais9Player1"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+9"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintEnd_toEndOf="@+id/btnMais1Player1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/btnMais1Player1"
            app:layout_constraintTop_toBottomOf="@+id/btnMais1Player1" />

        <Button
            android:id="@+id/btnMais9Player2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+9"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintEnd_toEndOf="@+id/btnMais1Player2"
            app:layout_constraintStart_toStartOf="@+id/btnMais1Player2"
            app:layout_constraintTop_toBottomOf="@+id/btnMais1Player2" />

        <Button
            android:id="@+id/btnMais12Player1"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+12"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnMais9Player1"
            app:layout_constraintEnd_toEndOf="@+id/btnMais3Player1"
            app:layout_constraintStart_toEndOf="@+id/btnMais1Player1"
            app:layout_constraintTop_toTopOf="@+id/btnMais9Player1" />

        <Button
            android:id="@+id/btnMais12Player2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+12"
            android:textColor="@color/btn_soma_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_soma_background"
            app:cornerRadius="27dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnMais9Player2"
            app:layout_constraintEnd_toEndOf="@+id/btnMais3Player2"
            app:layout_constraintStart_toStartOf="@+id/btnMais3Player2"
            app:layout_constraintTop_toTopOf="@+id/btnMais9Player2" />

        <Button
            android:id="@+id/btnMenos1Player2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="-1"
            android:textColor="@color/btn_subtrair_text"
            android:textSize="14sp"
            app:backgroundTint="@color/btn_subtrair_background"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnMais12Player2"
            app:layout_constraintEnd_toEndOf="@+id/btnMais6Player2"
            app:layout_constraintStart_toStartOf="@+id/btnMais6Player2"
            app:layout_constraintTop_toBottomOf="@+id/btnMais3Player2" />

        <Button
            android:id="@+id/btnMenos1Player1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="-1"
            android:textColor="@color/btn_subtrair_text"
            android:textSize="14sp"
            app:backgroundTint="@color/btn_subtrair_background"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnMais12Player1"
            app:layout_constraintEnd_toEndOf="@+id/btnMais6Player1"
            app:layout_constraintStart_toStartOf="@+id/btnMais6Player1"
            app:layout_constraintTop_toBottomOf="@+id/btnMais6Player1" />

        <Button
            android:id="@+id/btn_historico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            app:icon="@drawable/ic_zerar_historico"
            app:iconGravity="textEnd"
            app:iconPadding="16dp"
            app:iconTint="@color/white"
            android:text="@string/btn_ver_historico"
            android:textColor="@color/btn_historico_text"
            app:backgroundTint="@color/btn_historico_background"
            app:cornerRadius="4dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_zerar_pontos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
            app:layout_constraintTop_toBottomOf="@+id/btnMais12Player2"
            app:layout_constraintVertical_bias="1.0"
            app:layout_constraintWidth_max="300dp" />

        <Button
            android:id="@+id/btn_zerar_pontos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            app:icon="@drawable/ic_zerar_pontos"
            app:iconGravity="textEnd"
            app:iconPadding="16dp"
            app:iconTint="@color/white"
            android:text="@string/btn_zerar_pontos"
            android:textColor="@color/btn_zerar_text"
            app:backgroundTint="@color/btn_zerar_pontos_background"
            app:cornerRadius="4dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_zerar_historico"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
            app:layout_constraintWidth_max="300dp" />

        <Button
            android:id="@+id/btn_zerar_historico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:icon="@drawable/ic_zerar_historico"
            app:iconGravity="textEnd"
            app:iconPadding="16dp"
            app:iconTint="@color/white"
            android:text="@string/btn_zerar_historico"
            android:textColor="@color/btn_zerar_text"
            app:backgroundTint="@color/btn_zerar_historico_background"
            app:cornerRadius="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineCentro"
            app:layout_constraintWidth_max="300dp" />

        <ImageView
            android:id="@+id/img_joker"
            android:layout_width="174dp"
            android:layout_height="199dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCentro"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_launcher_foreground"
            android:importantForAccessibility="no"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>